# Copy to .env and fill in. `.env` is gitignored — never commit it.
#
# Stack: postgres + indexer (Carbon/Rust pipeline) + api (GraphQL) + prometheus + grafana.
# `DATABASE_URL` is NOT a variable here -- docker-compose.yml composes it internally from
# POSTGRES_PASSWORD (ruling R2: no separate DATABASE_URL secret to keep in sync).
#
# The old SubQuery stack's rollback file, docker-compose.subquery.yml, reuses
# POSTGRES_PASSWORD/GRAFANA_PASSWORD/GRAFANA_PORT/PROMETHEUS_PORT from this same .env; it
# additionally needs GRPC_PORT (see that file), which the active stack below does not use.

# Alchemy API key used for the Solana devnet Yellowstone gRPC stream (indexer) and JSON-RPC
# endpoint (indexer's block-time/backfill/reconcile RPC calls; api's /health and syncStatus
# chain-tip check). Create one at https://dashboard.alchemy.com/ with the "Solana Devnet"
# network enabled. Required -- both indexer and api refuse to start without it.
ALCHEMY_API_KEY=your-alchemy-api-key

# Password for the stack-internal Postgres instance.
# NOTE: applied only on FIRST initialization of the pgdata volume — changing it
# later requires an ALTER USER inside postgres first (see docs/deployment.md).
# NOTE: docker compose expands $ in .env values — if your value contains a
# literal $, write it as $$ or wrap the whole value in single quotes.
POSTGRES_PASSWORD=change-me

# Rust log filter for both indexer and api (env_logger syntax, e.g. "info" or
# "debug,hyper=warn"). Optional -- each binary has its own sensible default if unset, and
# docker-compose.yml's own fallback (info,hyper=warn,h2=warn,tonic=warn,rustls=warn for the
# indexer; info for api) is a better starting point than a bare "info" -- leave commented out
# unless you want to override it.
# RUST_LOG=info

# Published host ports (defaults shown). Only api (GraphQL) and grafana are published;
# prometheus is loopback-only (below) and indexer publishes nothing to the host.
GRAPHQL_PORT=3010
GRAFANA_PORT=3011

# Prometheus is published on the loopback interface only (127.0.0.1), never on
# a public interface — it has no authentication. This just picks which local
# port an SSH tunnel targets; see docs/deployment.md.
PROMETHEUS_PORT=9090

# Grafana admin password (username: admin). Defaults to `admin` when unset,
# which is fine locally. In production it comes from the GRAFANA_PASSWORD
# GitHub secret, and the deploy refuses to run without it.
GRAFANA_PASSWORD=admin

# Comma-separated list of website origins allowed to call the GraphQL API from a browser
# (CORS), e.g. https://app.example.com,http://localhost:3000. Unset, empty, or `*` = allow
# every origin (the default).
# CORS_ALLOWED_ORIGINS=https://app.example.com

# Image pins for prod (Task 8's deploy workflow writes sha-tagged GHCR images here on the
# server). Leave unset locally -- docker-compose.yml then builds each image from source
# via its `build:` fallback.
# PG_IMAGE=ghcr.io/<org>/indexer-postgres:sha-xxxxxxx
# INDEXER_IMAGE=ghcr.io/<org>/indexer:sha-xxxxxxx
# API_IMAGE=ghcr.io/<org>/indexer-api:sha-xxxxxxx

# --- Advanced: indexer overrides -------------------------------------------------------
# Every one of these has a working default baked into crates/indexer/src/config.rs; set
# only to override for a specific deployment. Uncomment and pass through in
# docker-compose.yml's `indexer.environment` if you need one of these.
# ALCHEMY_GRPC_URL=https://solana-devnet.g.alchemy.com
# ALCHEMY_RPC_URL=https://solana-devnet.g.alchemy.com/v2/your-alchemy-api-key
# RPC_FALLBACK_URL=https://api.devnet.solana.com
# Narrow the indexed set to a comma-separated subset of the registry names
# (xcavate_whitelist, regions, marketplace, property). Default: all four. Program
# addresses and backfill floors are compiled in (crates/indexer/src/programs.rs) -- the
# old PROGRAM_ID/BACKFILL_START_SLOT overrides are gone; a decoder only recognises its
# compiled-in program, so overriding the address never worked anyway.
# PROGRAMS=xcavate_whitelist,regions,marketplace,property
# METRICS_ADDR=0.0.0.0:9464
# RECONCILE_INTERVAL=300
# Property-metadata fetcher poll interval in seconds (ADR-27): how often the background
# loop re-checks which assets need their metadata_uri (re)fetched. The fetch itself is
# bounded and per-URI backed off, so the interval costs nothing while nothing is pending.
# METADATA_FETCH_INTERVAL=30
