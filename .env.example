# Copy to .env and fill in. `.env` is gitignored — never commit it.

# Alchemy API key used for the Solana devnet JSON-RPC endpoint
# (https://solana-devnet.g.alchemy.com/v2/<key>). Create one at
# https://dashboard.alchemy.com/ with the "Solana Devnet" network enabled.
ALCHEMY_API_KEY=your-alchemy-api-key

# Password for the stack-internal Postgres instance.
POSTGRES_PASSWORD=change-me

# Published host ports (defaults shown).
GRAPHQL_PORT=3000
GRPC_PORT=50051
