  "query": "\n        SELECT pubkey, slot, lamports, closed_at_slot, seller, amount, price\n        FROM realxhub_share_listing\n        WHERE ($1::bytea IS NULL OR seller = $1)\n          AND ($2::bool IS NULL OR (closed_at_slot IS NULL) = $2)\n        ORDER BY slot DESC, pubkey ASC\n        LIMIT $3 OFFSET $4\n        ",
