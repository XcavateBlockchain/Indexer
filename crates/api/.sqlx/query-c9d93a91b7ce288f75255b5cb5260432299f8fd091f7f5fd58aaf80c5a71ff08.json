  "query": "\n            SELECT program_id, upgrade_slot, signature, source, detected_at\n            FROM program_upgrades\n            WHERE ($1::bytea IS NULL OR program_id = $1)\n              AND ($2::bytea[] IS NULL OR program_id = ANY($2))\n            ORDER BY upgrade_slot ASC\n            ",
