  "query": "\n        SELECT pubkey, slot, lamports, closed_at_slot, hub_id, owner, amount, listed, per_share, pending\n        FROM realxhub_holding\n        WHERE ($1::bool IS NULL OR (closed_at_slot IS NULL) = $1)\n        ORDER BY slot DESC, pubkey ASC\n        LIMIT $2 OFFSET $3\n        ",
