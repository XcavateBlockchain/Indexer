  "query": "\n        SELECT event_id, event_type, payload\n        FROM webhook_events\n        WHERE delivered_at IS NULL\n          AND (next_attempt_at IS NULL OR next_attempt_at <= now())\n          AND event_type = ANY($2)\n        ORDER BY event_id ASC\n        LIMIT $1\n        ",
